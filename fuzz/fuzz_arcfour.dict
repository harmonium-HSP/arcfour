# AAD patterns
aad_empty=""
aad_short="test"
aad_http="HTTP/1.1"
aad_json="{\"type\":\"test\"}"

# Edge case inputs
input_empty=""
input_single="\x00"
input_255_bytes="\x00"
input_256_bytes="\x00"
input_all_zero="\x00"
input_all_ff="\xff"

# RC4 known weak patterns
weak_keystream="\xde\xad\xbe\xef"
weak_nonce="\x00\x00\x00\x00"

# Buffer overflow triggers
large_size="\xff\xff\xff\xff"
medium_size="\x00\x00\x40\x00"  # 16384 bytes

# Alignment patterns
aligned_addr="\x00\x00\x00\x00"
unaligned_addr="\x01\x00\x00\x00"