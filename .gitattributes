# Line ending settings
*.sh text eol=lf
*.c text eol=lf
*.h text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cmake text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.in text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.wasm binary
*.a binary
*.lib binary
*.dll binary
*.so binary
*.dylib binary

# Executable scripts
*.sh executable